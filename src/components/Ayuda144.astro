---
// Recuadro de ayuda. Se muestra en el inicio, en Acerca y en los temas de género y violencia.
import { UI, type Lang } from '../i18n/ui';
const { lang } = Astro.props as { lang: Lang };
const t = UI[lang].ayuda;
---
<aside class="ayuda" role="note">
  <strong aria-hidden="true">144</strong>
  <div><b>{t.titulo}</b><br />{t.texto}</div>
</aside>

<style>
  .ayuda {
    display: flex; gap: 16px; align-items: center;
    background: var(--violeta-bg);
    border-radius: 20px; padding: 18px 24px; margin: 40px 0; line-height: 1.55;
  }
  strong { font-size: 2.6rem; line-height: 1; font-family: var(--display); font-weight: 800; color: var(--violeta); }
</style>
