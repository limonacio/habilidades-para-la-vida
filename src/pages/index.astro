---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Ayuda144 from '../components/Ayuda144.astro';
import { EJES, type Eje } from '../ejes';

// Traemos todos los temas y los ordenamos por el campo "orden".
const temas = (await getCollection('temas')).sort((a, b) => a.data.orden - b.data.orden);
const ejes = Object.keys(EJES) as Eje[];
---
<Base title="Inicio">
  <div class="wrap">
    <section class="hero">
      <h1>Herramientas para vivir y convivir mejor</h1>
      <p>Una guía abierta sobre emociones, vínculos, género y derechos, explicada en simple y con las fuentes de cada idea.</p>
      <label class="search">
        <span class="sr-only">Buscar un tema</span>
        <input id="q" type="search" placeholder="Buscar un tema: ira, límites, micromachismos…" autocomplete="off" />
      </label>
      <div class="chips" id="chips" role="group" aria-label="Filtrar por eje">
        <button type="button" class="chip on" data-f="all" aria-pressed="true">Todos</button>
        {ejes.map((k) => <button type="button" class="chip" data-f={k} aria-pressed="false">{EJES[k].corto}</button>)}
      </div>
    </section>

    <div id="temas">
      {ejes.map((k) => {
        const lista = temas.filter((t) => t.data.eje === k);
        return (
          <section class={`eje ${k}`} data-eje={k}>
            <div class="eje-head"><h2>{EJES[k].nombre}</h2><small><span class="n">{lista.length}</span> <span class="pl">{lista.length === 1 ? 'tema' : 'temas'}</span></small></div>
            <div class="grid">
              {lista.map((t) => (
                <a class="card" href={`/temas/${t.id}/`}
                   data-texto={`${t.data.title} ${t.data.descripcion} ${t.data.autores}`.toLowerCase()}>
                  <h3>{t.data.title}</h3>
                  <p>{t.data.descripcion}</p>
                  <span class="meta">{t.data.autores} · {t.data.lectura} min</span>
                </a>
              ))}
            </div>
          </section>
        );
      })}
      <p id="vacio" class="vacio" hidden>No hay temas con esa búsqueda.</p>
    </div>

    <section class="ejercicios" id="ejercicios">
      <h2>Ejercicios para practicar</h2>
      <p class="sub">Herramientas interactivas. Lo que escribas va a quedar solo en tu navegador. <b>Próximamente.</b></p>
      <div class="ej-grid">
        <div class="ej h"><span aria-hidden="true">🌬️</span><b>Respiración guiada</b>Seguí el círculo para respirar con el diafragma.</div>
        <div class="ej e"><span aria-hidden="true">🌡️</span><b>Escala del enojo</b>Ubicá tu enojo del 1 al 10 y mirá qué podés hacer.</div>
        <div class="ej e"><span aria-hidden="true">📓</span><b>Diario de pensamientos</b>Registrá situaciones y revisá cuánto creés en cada pensamiento.</div>
      </div>
    </section>

    <Ayuda144 />
  </div>
</Base>

<script>
  // Buscador y filtros: todo ocurre en el navegador, sin servidor.
  // Cada tarjeta tiene su texto en data-texto; mostramos u ocultamos según lo escrito.
  const q = document.getElementById('q') as HTMLInputElement;
  const chips = document.querySelectorAll<HTMLButtonElement>('.chip');
  let filtro = 'all';

  const normalizar = (s: string) => s.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '');

  function aplicar() {
    const texto = normalizar(q.value.trim());
    let total = 0;
    document.querySelectorAll<HTMLElement>('.eje').forEach((sec) => {
      let visibles = 0;
      sec.querySelectorAll<HTMLElement>('.card').forEach((card) => {
        const ok = normalizar(card.dataset.texto ?? '').includes(texto);
        card.hidden = !ok;
        if (ok) visibles++;
      });
      const mostrar = (filtro === 'all' || filtro === sec.dataset.eje) && visibles > 0;
      sec.hidden = !mostrar;
      sec.querySelector('.n')!.textContent = String(visibles);
      sec.querySelector('.pl')!.textContent = visibles === 1 ? 'tema' : 'temas';
      if (mostrar) total += visibles;
    });
    document.getElementById('vacio')!.hidden = total > 0;
  }

  q.addEventListener('input', aplicar);
  chips.forEach((c) =>
    c.addEventListener('click', () => {
      filtro = c.dataset.f!;
      chips.forEach((x) => { x.classList.toggle('on', x === c); x.setAttribute('aria-pressed', String(x === c)); });
      aplicar();
    }),
  );
</script>

<style>
  .hero { padding: 72px 0 40px; text-align: center; }
  .hero h1 { font-size: clamp(2.2rem, 5vw, 3.4rem); }
  .hero p { max-width: 640px; margin: 0 auto 28px; color: var(--muted); font-size: 1.1rem; }
  .search { max-width: 560px; margin: 0 auto 18px; display: flex; background: var(--surface); border: 1px solid var(--line);
    border-radius: 14px; box-shadow: var(--shadow); padding: 4px 16px; }
  .search input { flex: 1; border: 0; background: transparent; color: var(--text); font: inherit; padding: 10px 0; outline: none; }
  .search:focus-within { outline: 3px solid var(--violeta); outline-offset: 2px; }
  .chips { display: flex; gap: 8px; justify-content: center; flex-wrap: wrap; }
  .chip { border: 1px solid var(--line); background: var(--surface); color: var(--text); border-radius: 999px;
    padding: 6px 14px; font: inherit; font-size: .9rem; cursor: pointer; }
  .chip.on { background: var(--text); color: var(--bg); border-color: var(--text); }
  .eje { margin: 48px 0; }
  .eje[hidden], .card[hidden] { display: none; }
  .eje-head { display: flex; align-items: baseline; gap: 12px; margin-bottom: 16px; border-bottom: 2px solid var(--c); padding-bottom: 8px; }
  .eje-head h2 { font-size: 1.5rem; color: var(--c); margin: 0; }
  .eje-head small { color: var(--muted); white-space: nowrap; }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 16px; }
  .card { background: var(--surface); border: 1px solid var(--line); border-top: 4px solid var(--c); border-radius: 14px;
    padding: 18px; box-shadow: var(--shadow); text-decoration: none; display: flex; flex-direction: column; gap: 6px; transition: transform .15s; }
  .card:hover { transform: translateY(-3px); }
  .card h3 { font-size: 1.15rem; margin: 0; }
  .card p { margin: 0; color: var(--muted); font-size: .95rem; }
  .card .meta { margin-top: auto; padding-top: 8px; font-size: .8rem; color: var(--c); font-weight: 700; }
  .vacio { text-align: center; color: var(--muted); }
  .ejercicios { background: var(--surface); border: 1px solid var(--line); border-radius: 20px; padding: 32px; margin: 48px 0; }
  .sub { color: var(--muted); margin: 0; }
  .ej-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 16px; margin-top: 16px; }
  .ej { background: var(--cbg); border-radius: 14px; padding: 20px; }
  .ej b { display: block; font-family: Fraunces, serif; font-size: 1.1rem; margin: 8px 0 4px; }
  @media (max-width: 600px) { .hero { padding: 48px 0 24px; } .ejercicios { padding: 20px; } }
</style>
