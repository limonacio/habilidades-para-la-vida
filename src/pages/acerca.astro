---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Ayuda144 from '../components/Ayuda144.astro';

// Bibliografía general: juntamos las fuentes de todos los temas, sin repetir, en orden alfabético.
const temas = await getCollection('temas');
const biblio = [...new Set(temas.flatMap((t) => t.data.fuentes))].sort((a, b) => a.localeCompare(b, 'es'));
const cursiva = (s: string) => s.replace(/\*(.+?)\*/g, '<i>$1</i>');
---
<Base title="Acerca" description="Qué es esta guía, quién la hizo, bibliografía y licencia.">
  <div class="wrap acerca">
    <h1>Acerca de esta guía</h1>

    <h2>Qué es</h2>
    <p>
      <b>Habilidades para la Vida</b> es una guía abierta y gratuita que reúne, ordena y explica en lenguaje simple
      herramientas sobre emociones, vínculos, género y derechos humanos.
    </p>
    <p>
      Esta guía <b>no crea teoría</b>: organiza y explica ideas de autoras, autores, tratados y leyes. Cada tema indica
      sus fuentes, y abajo está la bibliografía completa para quien quiera profundizar.
    </p>

    <h2>Quién la hizo</h2>
    <p>
      La diseñó y desarrolló <a href="https://www.limonacio.com">Limonacio</a>, como proyecto personal y de divulgación.
    </p>

    <h2>Aviso importante</h2>
    <p>
      Este contenido es informativo. <b>No reemplaza la consulta con profesionales de la salud mental, el derecho u otras áreas.</b>
      Si estás atravesando una situación difícil, buscá acompañamiento.
    </p>
    <Ayuda144 />

    <h2>Licencia</h2>
    <p>
      El contenido está bajo licencia
      <a href="https://creativecommons.org/licenses/by-sa/4.0/deed.es" rel="license">Creative Commons Atribución-CompartirIgual 4.0 (CC BY-SA 4.0)</a>.
      Podés copiarlo, compartirlo y adaptarlo, incluso para talleres, siempre que menciones la fuente y compartas lo tuyo con la misma licencia.
    </p>

    <h2 id="bibliografia">Bibliografía</h2>
    <ul class="biblio">{biblio.map((f) => <li set:html={cursiva(f)} />)}</ul>
  </div>
</Base>

<style>
  .acerca { max-width: 760px; padding-top: 48px; }
  .acerca h1 { font-size: clamp(2rem, 4.5vw, 3rem); }
  .acerca h2 { font-size: 1.5rem; margin-top: 1.6em; }
  .biblio { padding-left: 20px; font-size: .95rem; }
  .biblio li { margin-bottom: 8px; }
</style>
