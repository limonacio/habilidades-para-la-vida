---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Ayuda144 from '../../components/Ayuda144.astro';
import { UI, prefijo, pathsIdioma, type Lang, type Eje } from '../../i18n/ui';

// Una versión de esta página por idioma: /, /en/, /pt/
export const getStaticPaths = pathsIdioma;
const { lang } = Astro.props as { lang: Lang };
const t = UI[lang];
const base = prefijo(lang);

// Temas de este idioma, ordenados por el campo "orden".
const temas = (await getCollection('temas', (e) => e.id.startsWith(`${lang}/`))).sort((a, b) => a.data.orden - b.data.orden);
const slug = (id: string) => id.split('/')[1];
const ejes: Eje[] = ['g', 'e', 'h'];
---
<Base lang={lang} title={t.sitio}>
  <div class="wrap">
    <section class="hero">
      <h1>{t.hero.titulo}</h1>
      <p>{t.hero.bajada}</p>
      <label class="search">
        <svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20"><circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2"/><path d="m20 20-4-4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        <span class="sr-only">{t.buscar.label}</span>
        <input id="q" type="search" placeholder={t.buscar.placeholder} autocomplete="off" data-indice={`${base}/buscar.json`} data-vacio={t.buscar.vacio} />
      </label>
      <!-- Resultados justo debajo del campo, para verlos sin moverse -->
      <ul id="res" class="res" hidden></ul>
    </section>

    <!-- Accesos rápidos a los recursos más visuales -->
    <section class="destacados" aria-labelledby="destacados-t">
      <h2 id="destacados-t">{t.destacados.titulo}</h2>
      <div class="dest-grid">
        {t.destacados.items.map(([icono, titulo, texto, ruta]) => (
          <a class="dest g" href={`${base}${ruta}`}><span aria-hidden="true">{icono}</span><b>{titulo}</b>{texto}</a>
        ))}
      </div>
    </section>

    <div id="temas">
      {ejes.map((k) => {
        const lista = temas.filter((x) => x.data.eje === k);
        return (
          <section class={`eje ${k}`} id={`eje-${k}`}>
            <h2>{t.ejes[k]}</h2>
            <div class="lista">
              {lista.map((tema) => (
                <details class="tema" data-slug={slug(tema.id)}>
                  <summary>
                    <span>{tema.data.title}</span>
                    <svg class="chev" aria-hidden="true" viewBox="0 0 24 24" width="20" height="20"><path d="m6 9 6 6 6-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  </summary>
                  <div class="detalle">
                    <p>{tema.data.descripcion}</p>
                    <p class="meta">{tema.data.autores}</p>
                    <a class="leer" href={`${base}/temas/${slug(tema.id)}/`}>{t.leer}</a>
                  </div>
                </details>
              ))}
            </div>
          </section>
        );
      })}

      <section class="ejercicios" id="ejercicios">
        <h2>{t.ejercicios.titulo}</h2>
        <p class="sub">{t.ejercicios.bajada} <b>{t.ejercicios.pronto}</b></p>
        <div class="ej-grid">
          {t.ejercicios.items.map(([titulo, texto], i) => (
            <div class={`ej ${i === 0 ? 'h' : 'e'}`}><span aria-hidden="true">{['🌬️', '🌡️', '📓'][i]}</span><b>{titulo}</b>{texto}</div>
          ))}
        </div>
      </section>
    </div>


    <Ayuda144 lang={lang} />
  </div>
</Base>

<script>
  // ── Buscador ─────────────────────────────────────────────────────────
  // Busca en los destacados, los temas, sus subtítulos y su texto, y muestra
  // hasta 6 resultados debajo del campo, con enlace directo a esa parte.
  type Entrada = { t: string; c: string; u: string; x?: string; w: number; nt: string; nx: string };
  const q = document.getElementById('q') as HTMLInputElement;
  const res = document.getElementById('res') as HTMLUListElement;

  // Sin tildes ni mayúsculas, y todo lo que no sea letra o número pasa a ser espacio.
  // Cambia cada carácter por uno solo, así las posiciones coinciden con el texto original.
  const normalizar = (s: string) => s.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/[^a-z0-9]/g, ' ');

  // Palabras "vacías": no ayudan a encontrar nada ("iceberg de la violencia" = "iceberg violencia").
  const VACIAS = new Set('de la el los las del al lo y e o u a en un una con por para que se the of and to in an da do das dos na no nos um uma com os as'.split(' '));

  // El índice se descarga recién la primera vez que alguien usa el buscador.
  let indice: Entrada[] = [];
  let carga: Promise<void> | undefined;
  const cargar = () => (carga ??= fetch(q.dataset.indice!).then((r) => r.json()).then((d: Entrada[]) => {
    indice = d.map((e) => ({ ...e, nt: ' ' + normalizar(e.t), nx: ' ' + normalizar(e.x ?? '') }));
  }));
  q.addEventListener('focus', cargar, { once: true });

  function buscar(texto: string) {
    let palabras = normalizar(texto).split(' ').filter(Boolean);
    const utiles = palabras.filter((p) => !VACIAS.has(p));
    if (utiles.length) palabras = utiles;
    const mejores = new Map<string, { e: Entrada; puntos: number; pos: number; largo: number }>();
    for (const e of indice) {
      let puntos = 0, pos = -1, largo = 0;
      for (const p of palabras) {
        // " " + palabra = la palabra tiene que EMPEZAR así ("ice" encuentra "iceberg")
        if (e.nt.includes(' ' + p)) { puntos += 3; continue; }
        const i = e.nx.indexOf(' ' + p);
        if (i >= 0) { puntos += 1; if (pos < 0) { pos = i; largo = p.length; } continue; }
        puntos = -1; break; // falta una palabra: no sirve
      }
      if (puntos < 0) continue;
      puntos *= e.w;
      const previo = mejores.get(e.u); // si hay dos entradas con el mismo enlace, queda la mejor
      if (!previo || previo.puntos < puntos) mejores.set(e.u, { e, puntos, pos, largo });
    }
    return [...mejores.values()].sort((a, b) => b.puntos - a.puntos).slice(0, 6);
  }

  // Un fragmento del texto alrededor de la palabra, con la palabra resaltada.
  function fragmento(x: string, pos: number, largo: number) {
    const desde = Math.max(0, pos - 40), hasta = Math.min(x.length, pos + largo + 60);
    const small = document.createElement('small');
    const mark = document.createElement('mark');
    mark.textContent = x.slice(pos, pos + largo);
    small.append((desde > 0 ? '…' : '') + x.slice(desde, pos), mark, x.slice(pos + largo, hasta) + (hasta < x.length ? '…' : ''));
    return small;
  }

  async function mostrar() {
    const texto = q.value.trim();
    if (!texto) { res.hidden = true; return; }
    await cargar();
    const encontrados = buscar(texto);
    res.replaceChildren(...encontrados.map(({ e, pos, largo }) => {
      const li = document.createElement('li');
      const a = document.createElement('a');
      a.href = e.u;
      const b = document.createElement('b');
      b.textContent = e.t;
      const c = document.createElement('small');
      c.textContent = e.c;
      a.append(b, pos >= 0 && e.x ? fragmento(e.x, pos, largo) : c);
      li.append(a);
      return li;
    }));
    if (!encontrados.length) {
      const li = document.createElement('li');
      li.className = 'nada';
      li.textContent = q.dataset.vacio!;
      res.append(li);
    }
    res.hidden = false;
  }

  q.addEventListener('input', mostrar);
  q.addEventListener('keydown', (ev) => {
    if (ev.key === 'Enter') { const a = res.querySelector('a'); if (a) location.href = a.href; }
    if (ev.key === 'Escape') { q.value = ''; res.hidden = true; }
  });

  // Si venís desde un tema (?desde=slug), dejamos ese tema abierto y resaltado en su sección
  const desde = new URLSearchParams(location.search).get('desde');
  if (desde) {
    const d = document.querySelector<HTMLDetailsElement>(`details.tema[data-slug="${CSS.escape(desde)}"]`);
    if (d) { d.open = true; d.classList.add('resaltado'); setTimeout(() => d.classList.remove('resaltado'), 2000); }
  }
</script>

<style>
  .hero { padding: 64px 0 24px; text-align: center; }
  .hero h1 { font-size: clamp(2.2rem, 5vw, 3.4rem); }
  .hero p { max-width: 640px; margin: 0 auto 28px; color: var(--muted); font-size: 1.1rem; }

  /* Buscador: borde marcado para que se lea claramente como "lugar para escribir" */
  .search {
    max-width: 520px; margin: 0 auto; display: flex; align-items: center; gap: 10px;
    background: var(--surface); border: 2px solid color-mix(in srgb, var(--text) 45%, transparent);
    border-radius: 12px; padding: 4px 14px; color: var(--muted); cursor: text;
  }
  .search:focus-within { border-color: var(--text); outline: 3px solid color-mix(in srgb, var(--violeta) 45%, transparent); outline-offset: 2px; }
  .search input { flex: 1; border: 0; background: transparent; color: var(--text); font: inherit; font-size: 1.05rem; padding: 10px 0; outline: none; min-width: 0; }
  .search input::placeholder { color: var(--muted); }

  /* Lista de resultados: sobria, una línea de título y una de contexto */
  .res { max-width: 520px; margin: 10px auto 0; padding: 6px; list-style: none; text-align: left; background: var(--surface); border: 1px solid var(--line); border-radius: 12px; }
  .res[hidden] { display: none; }
  .res :global(a) { display: block; padding: 10px 12px; border-radius: 8px; color: var(--text); text-decoration: none; }
  .res :global(a:hover), .res :global(a:focus-visible) { background: color-mix(in srgb, var(--violeta) 12%, transparent); }
  .res :global(b) { display: block; font-weight: 600; }
  .res :global(small) { display: block; color: var(--muted); font-size: .85rem; margin-top: 2px; }
  .res :global(mark) { background: color-mix(in srgb, var(--violeta) 22%, transparent); color: inherit; border-radius: 3px; }
  .res :global(.nada) { padding: 10px 12px; color: var(--muted); text-align: center; }

  /* Cada eje es un bloque con fondo propio y aire alrededor, para que no se vea "un solo edificio" */
  .eje { background: var(--cbg); border: 1px solid color-mix(in srgb, var(--c) 30%, transparent); border-radius: 20px; padding: 24px; margin: 56px 0; }
  .eje h2 { font-size: 1.45rem; color: var(--c); margin: 0 0 20px; }
  .lista { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 12px; align-items: start; }

  /* Tema plegable: se ve solo el título; al tocarlo se despliega la descripción */
  .tema { background: var(--surface); border-radius: 12px; border: 1px solid color-mix(in srgb, var(--c) 35%, transparent); border-left: 5px solid var(--c); box-shadow: var(--shadow); }
  .tema summary:hover { color: var(--c); }
  .tema summary {
    list-style: none; cursor: pointer; display: flex; align-items: center; justify-content: space-between; gap: 12px;
    padding: 14px 16px; font-family: Fraunces, Georgia, serif; font-weight: 700; font-size: 1.08rem;
  }
  .tema summary::-webkit-details-marker { display: none; }
  .eje { scroll-margin-top: 84px; }
  .tema.resaltado { outline: 3px solid var(--c); outline-offset: 2px; transition: outline-color 1s; }
  .chev { flex: none; color: var(--c); transition: transform .2s; }
  .tema[open] .chev { transform: rotate(180deg); }
  .detalle { padding: 0 16px 16px; }
  .detalle p { margin: 0 0 8px; color: var(--muted); font-size: .95rem; }
  .detalle .meta { font-size: .82rem; font-weight: 700; color: var(--c); }
  .leer { display: inline-block; margin-top: 4px; background: var(--c); color: var(--surface); text-decoration: none; font-weight: 700; font-size: .92rem; padding: 8px 16px; border-radius: 999px; }
  .leer::after { content: ' →'; }

  .destacados { margin: 16px 0 0; }
  .destacados h2 { margin-bottom: 16px !important; }
  .destacados h2 { font-size: 1.3rem; margin: 0 0 12px; }
  .dest-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; }
  @media (max-width: 1060px) { .dest-grid { grid-template-columns: repeat(2, 1fr); } }
  .dest { display: grid; grid-template-columns: auto 1fr; column-gap: 12px; align-items: start; background: var(--surface);
    border: 1px solid color-mix(in srgb, var(--c) 35%, transparent); border-radius: 14px; padding: 14px 16px; text-decoration: none;
    color: var(--muted); font-size: .9rem; box-shadow: var(--shadow); transition: transform .15s; }
  .dest:hover { transform: translateY(-2px); border-color: var(--c); }
  .dest span { grid-row: span 2; font-size: 1.6rem; line-height: 1.2; }
  .dest b { color: var(--text); font-family: Fraunces, serif; font-size: 1.05rem; }
  @media (max-width: 760px) { .dest-grid { grid-template-columns: 1fr; } }
  .ejercicios { background: var(--surface); border: 1px solid var(--line); border-radius: 20px; padding: 32px; margin: 56px 0; }
  .sub { color: var(--muted); margin: 0; }
  .ej-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 16px; margin-top: 16px; }
  .ej { background: var(--cbg); border-radius: 14px; padding: 20px; }
  .ej b { display: block; font-family: Fraunces, serif; font-size: 1.1rem; margin: 8px 0 4px; }
  /* Escritorio: tablero de 2 x 2 → Género | Emociones / Habilidades | Ejercicios */
  @media (min-width: 1000px) {
    #temas { display: grid; grid-template-columns: repeat(2, 1fr); gap: 36px; align-items: start; margin: 64px 0 72px; }
    .eje, .ejercicios { margin: 0; }
    .lista { grid-template-columns: 1fr; }
    .ej-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 600px) {
    .hero { padding: 40px 0 16px; }
    .eje { padding: 18px 14px; margin: 40px 0; }
    .lista { grid-template-columns: 1fr; }
    .ejercicios { padding: 20px; }
    /* En el celular, los destacados bajan al final (antes del recuadro de ayuda)
       para no tapar los temas ni los resultados de búsqueda. */
    .wrap { display: flex; flex-direction: column; }
    .hero { order: -2; }
    #temas { order: -1; }
    .destacados { margin-top: 24px; }
  }
</style>
